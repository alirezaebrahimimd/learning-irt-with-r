# Learning Item Response Theory with R
# Part 1: Exploring the ability dataset
# Install packages only if they are unavailable
packages <- c("psychTools", "mirt", "tidyverse")
missing_packages <- packages[
!packages %in% rownames(installed.packages())
]
if (length(missing_packages) > 0) {
install.packages(missing_packages)
}
# Load packages
library(psychTools)
library(mirt)
library(tidyverse)
# Load the dataset
data("ability")
# Inspect its structure
dim(ability)
names(ability)
head(ability)
str(ability)
summary(ability)
# ----------------------------------------------------------
# Part 2: Descriptive item analysis
# ----------------------------------------------------------
# Proportion answering each item correctly
proportion_correct <- colMeans(ability, na.rm = TRUE)
# Number of missing responses for each item
missing_responses <- colSums(is.na(ability))
# Combine the results
item_summary <- data.frame(
item = names(proportion_correct),
proportion_correct = as.numeric(proportion_correct),
percent_correct = round(100 * proportion_correct, 1),
missing = as.numeric(missing_responses)
)
# Sort from easiest to hardest
item_summary <- item_summary[
order(item_summary$proportion_correct, decreasing = TRUE),
]
item_summary
ggplot(
item_summary,
aes(
x = reorder(item, proportion_correct),
y = proportion_correct
)
) +
geom_col(fill = "steelblue") +
coord_flip() +
scale_y_continuous(
labels = scales::percent,
limits = c(0, 1)
) +
labs(
title = "Proportion of Correct Responses by Item",
subtitle = "Items are arranged from hardest to easiest",
x = "Item",
y = "Proportion correct"
) +
theme_minimal()
# Total missing responses
sum(is.na(ability))
# Percentage of all responses that are missing
mean(is.na(ability)) * 100
# Number of participants with complete data
sum(complete.cases(ability))
# Number of answered items per participant
items_answered <- rowSums(!is.na(ability))
summary(items_answered)
# Raw number correct
raw_score <- rowSums(ability, na.rm = TRUE)
# Keep track of how many questions each person answered
score_data <- data.frame(
raw_score = raw_score,
items_answered = items_answered
)
# Restrict this graph to people who answered all 16 items
complete_scores <- score_data$raw_score[
score_data$items_answered == 16
]
hist(
complete_scores,
breaks = seq(-0.5, 16.5, by = 1),
main = "Raw Scores Among Complete Respondents",
xlab = "Number of correct answers",
col = "steelblue",
border = "white"
)
# ----------------------------------------------------------
# Part 3: Classical item discrimination
# ----------------------------------------------------------
item_discrimination <- sapply(
seq_len(ncol(ability)),
function(j) {
item_response <- ability[, j]
# Score based on every item except the item being evaluated
remaining_score <- rowSums(
ability[, -j, drop = FALSE],
na.rm = TRUE
)
# Avoid scores based on too few answered items
remaining_answered <- rowSums(
!is.na(ability[, -j, drop = FALSE])
)
remaining_score[remaining_answered < 12] <- NA
cor(
item_response,
remaining_score,
use = "pairwise.complete.obs"
)
}
)
discrimination_summary <- data.frame(
item = colnames(ability),
proportion_correct = colMeans(ability, na.rm = TRUE),
item_total_correlation = item_discrimination
)
discrimination_summary <- discrimination_summary[
order(
discrimination_summary$item_total_correlation,
decreasing = TRUE
),
]
discrimination_summary
ggplot(
discrimination_summary,
aes(
x = reorder(item, item_total_correlation),
y = item_total_correlation
)
) +
geom_col(fill = "darkorange") +
coord_flip() +
geom_hline(
yintercept = 0.30,
linetype = "dashed",
color = "gray40"
) +
labs(
title = "Corrected Item–Total Correlations",
subtitle = "The dashed line marks a correlation of 0.30",
x = "Item",
y = "Corrected item–total correlation"
) +
theme_minimal()
# See the distribution of completed items
table(items_answered)
# Number of participants who answered no items
sum(items_answered == 0)
# Number who answered fewer than 12 of 16 items
sum(items_answered < 12)
# Remove only respondents who answered no items
ability_analysis <- ability[items_answered > 0, ]
# Confirm the new dimensions
dim(ability_analysis)
# Confirm nobody has zero observed responses
min(rowSums(!is.na(ability_analysis)))
View(ability.keys)
View(ability.keys)
